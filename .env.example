# Carbon Labs Environment Configuration

# Session secret used to sign session cookies (required)
SESSION_SECRET=replace-this-with-a-long-random-secret

# Frontend exposed public port (default: 8000)
FRONTEND_PORT=

# Docker socket path on host (default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=

# Host path for user volume bind mounts (defaults to ./volumes)
HOST_VOLUMES_DIR=

# Optional container settings (all defaults)
CHROMIUM_IMAGE=lscr.io/linuxserver/chromium:latest
CONTAINER_DNS=1.1.1.3,1.0.0.3
TZ=UTC
